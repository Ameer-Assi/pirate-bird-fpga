-- Cannon on a boat, 4 frames of 64x64 stacked, one per barrel angle, RGB332
-- frame 0: 15deg, 1: 35deg, 2: 55deg, 3: 75deg above horizontal, aiming up-left
-- addr = {frame[1:0], y[5:0], x[5:0]};  transparent = 0xFF
-- frame 0: muzzle ~(14, 26), muzzle_flash top-left = sprite top-left + (-9, 8)
-- frame 1: muzzle ~(18, 18), muzzle_flash top-left = sprite top-left + (-4, -3)
-- frame 2: muzzle ~(25, 11), muzzle_flash top-left = sprite top-left + (4, -11)
-- frame 3: muzzle ~(33, 7), muzzle_flash top-left = sprite top-left + (15, -16)
WIDTH=8;
DEPTH=16384;
ADDRESS_RADIX=UNS;
DATA_RADIX=HEX;
CONTENT BEGIN
